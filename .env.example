# Web3Forms API Key
# This key is designed to be public (client-side submission).
# You can restrict it to your domain in the Web3Forms dashboard.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY="your-web3forms-key"

# Backend API URL
# Local dev:   http://localhost:5000
# Production:  https://your-backend.railway.app
NEXT_PUBLIC_API_URL="http://localhost:5000"

# On-demand ISR revalidation secret
# Generate a strong random string. Must match REVALIDATION_SECRET in backend.
REVALIDATION_SECRET="your-revalidation-secret"

# Studio WhatsApp Number (digits only with country code, e.g. 919876543210)
# If left empty, the floating consultation button falls back to the /contact page.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

